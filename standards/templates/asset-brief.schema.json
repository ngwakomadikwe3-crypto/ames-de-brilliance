{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ames.asset-brief/1"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewedModelSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "loose-diamond",
            "loose-gemstone",
            "ring",
            "earrings",
            "necklace",
            "pendant",
            "bracelet",
            "chain",
            "brooch",
            "collection",
            "accessory"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "references": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,79}$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "maxLength": 2048
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "description",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "dimensionsMm": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "scaleEvidence": {
          "type": "string",
          "maxLength": 2000
        },
        "metalAndFinish": {
          "type": "string",
          "maxLength": 2000
        },
        "mainGemstone": {
          "type": "string",
          "maxLength": 2000
        },
        "additionalStones": {
          "type": "string",
          "maxLength": 2000
        },
        "construction": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "category",
        "description",
        "references",
        "dimensionsMm",
        "scaleEvidence",
        "metalAndFinish",
        "mainGemstone",
        "additionalStones",
        "construction"
      ],
      "additionalProperties": false
    },
    "deliverable": {
      "type": "string",
      "enum": [
        "concept-image",
        "product-render",
        "animation",
        "interactive-3d"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "ames-mobile",
        "ames-desktop",
        "blender-cycles"
      ]
    },
    "budget": {
      "type": "string",
      "enum": [
        "mobile-safe",
        "desktop-inspection"
      ]
    },
    "background": {
      "type": "string",
      "enum": [
        "transparent",
        "warm-ivory",
        "soft-champagne",
        "deep-charcoal",
        "rich-black"
      ]
    },
    "components": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "nodeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "metal",
              "gemstone",
              "pearl",
              "opal",
              "other"
            ]
          },
          "surface": {
            "type": "string",
            "enum": [
              "faceted",
              "polished-curved",
              "textured"
            ]
          },
          "materialPreset": {
            "type": "string",
            "maxLength": 80
          },
          "finish": {
            "type": "string",
            "enum": [
              "polished",
              "brushed",
              "satin",
              "hammered",
              "engraved"
            ]
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[a-fA-F0-9]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceIds": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,79}$"
            }
          }
        },
        "required": [
          "id",
          "nodeName",
          "role",
          "surface",
          "materialPreset",
          "finish",
          "color",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "requestedEffects": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dispersion",
          "birefringence",
          "pleochroism",
          "opalDiffraction"
        ]
      }
    },
    "views": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "front",
          "three-quarter",
          "side",
          "back",
          "underside",
          "macro"
        ]
      }
    },
    "assumptions": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 2000
      }
    },
    "reviews": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "reference-and-silhouette",
              "facets-and-depth",
              "stone-seating-and-prongs",
              "connections-and-clearances",
              "metal-and-finish",
              "scale-and-proportions",
              "all-views-readable",
              "mobile-and-tablet",
              "rights-and-product-facts"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "pass",
              "fail"
            ]
          },
          "reviewer": {
            "type": "string",
            "maxLength": 120
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "check",
          "status",
          "reviewer",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "assetId",
    "revision",
    "reviewedModelSha256",
    "product",
    "deliverable",
    "target",
    "budget",
    "background",
    "components",
    "requestedEffects",
    "views",
    "assumptions",
    "reviews"
  ],
  "additionalProperties": false
}
