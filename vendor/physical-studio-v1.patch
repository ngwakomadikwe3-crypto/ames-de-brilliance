+    controls.current.enableDamping = damping
+    // Request the committed camera frame after React/R3F finishes this update.
+    const frame = requestAnimationFrame(invalidate)
+    // Zoom is applied separately so zoom commands retain a manually chosen angle.
+    return () => cancelAnimationFrame(frame)
