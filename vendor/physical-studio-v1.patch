+    if (zoom === undefined || !controls.current) return
+    const target = controls.current.target
+    camera.position.sub(target).setLength(cameraFraming(cameraPreset ?? 'three_quarter', zoom).radius).add(target)
+    controls.current.update()
+    const frame = requestAnimationFrame(invalidate)
+    return () => cancelAnimationFrame(frame)
+  }, [zoom, resetToken, camera, invalidate])
+  return <OrbitControls ref={controls} enablePan={false} enableDamping dampingFactor={0.07}
+    minDistance={CAMERA_MIN_DISTANCE} maxDistance={CAMERA_MAX_DISTANCE * (cameraPreset === 'gemstone' ? GEMSTONE_LENS_RATIO : 1)}
+    minPolarAngle={Math.PI * (cameraPreset === 'gemstone' ? 0.035 : 0.15)} maxPolarAngle={Math.PI * 0.85}
+    onStart={() => onInteractionChange?.(true)} onEnd={() => onInteractionChange?.(false)} />
+}
