+import { useThree } from '@react-three/fiber'
+import { useEffect, useRef } from 'react'
+import { Spherical } from 'three'
+import type { OrbitControls as OrbitControlsImpl } from 'three-stdlib'
+import { cameraFraming, CAMERA_MIN_DISTANCE, CAMERA_MAX_DISTANCE } from './cameraFraming'
+import type { CameraPreset } from './cameraFraming'
+export function ViewerControls({ onInteractionChange, cameraPreset, zoom, resetToken }: {
+  onInteractionChange?: (active: boolean) => void
+  cameraPreset?: CameraPreset
+  zoom?: number
+  resetToken?: number
+}) {
+  const controls = useRef<OrbitControlsImpl>(null)
+  const camera = useThree(state => state.camera)
+  const invalidate = useThree(state => state.invalidate)
+  useEffect(() => {
+    if (!cameraPreset || !controls.current) return
+    // Clear prior damping deltas so a reset/preset cannot drift toward the old orbit.
+    const damping = controls.current.enableDamping
+    controls.current.enableDamping = false
+    controls.current.update()
+    controls.current.reset()
+    const perspective = camera as PerspectiveCamera
+    if (perspective.isPerspectiveCamera) {
+      perspective.fov = cameraPreset === 'gemstone' ? GEMSTONE_CAMERA_FOV : DIAMOND_CALIBRATION.camera.fov
