+/** Memory-conservative optical budget for low-cost touch devices such as Spark-family phones. */
+export function chooseGemstoneQuality(runtime: ViewerRuntimeProfile): ViewerQualityTier {
+  const tier = chooseViewerQuality(runtime)
+  if (runtime.forcedTier || tier === 'SAFE') return tier
+  if (runtime.coarsePointer && (runtime.deviceMemory ?? 4) <= 4) return 'LOW'
+  return tier
