# ─── Appwrite ───
# Appwrite endpoint URL (e.g. https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=your-appwrite-endpoint

# Appwrite project ID
APPWRITE_PROJECT_ID=your-project-id

# Appwrite API key (server-side, with databases + storage permissions)
APPWRITE_API_KEY=your-api-key

# ─── Authentication ───
# At least 32 random characters. Required; generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-strong-random-secret

# Optional emergency dashboard access codes. Leave blank to use staff accounts only.
OWNER_CODE=
COUSIN_CODE=

# ─── AI (DeepSeek or compatible) ───
# API key for the LLM provider
DEEPSEEK_API_KEY=your-api-key-here

# Base URL (OpenAI-compatible endpoint)
AI_BASE_URL=https://api.deepseek.com

# Model name
AI_MODEL=deepseek-chat

# ─── SAME Chat (Dify chatflow) ───
# Dify API key for the SAME concierge chatflow (server-side only)
DIFY_API_KEY=your-dify-api-key

# Dify API base URL, no path. Default is the hosted service; set your own
# host when self-hosting Dify. The route appends /v1/chat-messages.
DIFY_API_URL=https://api.dify.ai

# ─── Email Notifications (SMTP) ───
# SMTP server host (required for email notifications)
SMTP_HOST=smtp.example.com

# SMTP port (default: 587 for TLS, use 465 for SSL)
SMTP_PORT=587

# SMTP username / login
SMTP_USER=you@example.com

# SMTP password
SMTP_PASS=your-smtp-password

# "From" address (defaults to SMTP_USER)
SMTP_FROM=noreply@amesdebrilliance.co.bw

# Notification recipient (defaults to SMTP_USER)
NOTIFY_EMAIL=desk@amesdebrilliance.co.bw

# ─── Report Sharing ───
# HMAC secret for expiring report share links (staff-minted via
# POST /api/reports/share). Optional: falls back to SESSION_SECRET.
# Set a distinct value to rotate share links independently of sessions.
REPORT_SHARE_SECRET=

# Report share link lifetime in seconds (default 900 = 15 minutes,
# maximum 86400).
REPORT_SHARE_TTL_SECONDS=900
