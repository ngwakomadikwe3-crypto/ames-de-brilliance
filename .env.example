# ─── Appwrite ───
# Appwrite endpoint URL (e.g. https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=your-appwrite-endpoint

# Appwrite project ID
APPWRITE_PROJECT_ID=your-project-id

# Appwrite API key (server-side, with databases + storage permissions)
APPWRITE_API_KEY=your-api-key

# ─── Authentication ───
# At least 32 random characters. Required; generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-strong-random-secret

# Optional emergency dashboard access codes. Leave blank to use staff accounts only.
OWNER_CODE=
COUSIN_CODE=

# ─── AI (DeepSeek or compatible) ───
# API key for the LLM provider
DEEPSEEK_API_KEY=your-api-key-here

# Base URL (OpenAI-compatible endpoint)
AI_BASE_URL=https://api.deepseek.com

# Model name
AI_MODEL=deepseek-chat

# ─── SAME Chat (Dify chatflow) ───
# Dify API key for the SAME concierge chatflow (server-side only)
DIFY_API_KEY=your-dify-api-key

# Dify API base URL, no path. Default is the hosted service; set your own
# host when self-hosting Dify. The route appends /v1/chat-messages.
DIFY_API_URL=https://api.dify.ai

# ─── Auctions (Phase 2a) ───
# Max accepted bid attempts per bidder per minute, enforced with shared
# storage (Appwrite rate_limits table) so it holds across serverless
# instances. Optional; default is 12.
AUCTION_BID_RATE_LIMIT_PER_MINUTE=12

# ─── Email Notifications (SMTP) ───
# SMTP server host (required for email notifications)
SMTP_HOST=smtp.example.com

# SMTP port (default: 587 for TLS, use 465 for SSL)
SMTP_PORT=587

# SMTP username / login
SMTP_USER=you@example.com

# SMTP password
SMTP_PASS=your-smtp-password

# "From" address (defaults to SMTP_USER)
SMTP_FROM=noreply@amesdebrilliance.co.bw

# Notification recipient (defaults to SMTP_USER)
NOTIFY_EMAIL=desk@amesdebrilliance.co.bw

# ─── Auction Engine (Phase 2b) ───
# Bearer secret protecting /api/cron/* routes. Vercel automatically sends
# "Authorization: Bearer $CRON_SECRET" with cron invocations when set.
CRON_SECRET=

# Show a "reserve met" indicator on live lots. The reserve AMOUNT is never
# exposed either way. Owner approval required before enabling; default off.
AUCTION_SHOW_RESERVE_MET=0

# Client poll cadence for GET /api/lots, in milliseconds (build-time).
NEXT_PUBLIC_AUCTION_POLL_INTERVAL_MS=5000

# Backoff cadence while the browser tab is hidden, in milliseconds.
NEXT_PUBLIC_AUCTION_POLL_HIDDEN_INTERVAL_MS=60000

# ─── Bidder Accounts (Phase 3a) ───
# Public bidding gate. Default OFF: only staff sessions can bid, even though
# bidder registration/login may be open. Set to 1 ONLY with the owner's
# approval to let verified bidders (current terms accepted) place bids.
AUCTION_PUBLIC_BIDDING=0

# Canonical public origin of the deployment (e.g. https://ames.example.com).
# Same-origin enforcement on mutating API calls compares the request Origin
# header against this value (defaults to the request's own origin when unset).
AMES_APP_ORIGIN=
