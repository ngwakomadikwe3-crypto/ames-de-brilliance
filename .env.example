# Vercel server environment only. Fill through project settings, never commit values.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Server-only configuration: paste the exact real HTTPS Vercel origin; later the custom origin.
# No path or trailing slash. This value is configuration, not a credential.
AMES_APP_ORIGIN=
# Server-only, independently generated high-entropy signing secret, minimum 48 characters.
# Supply through Vercel environment settings; never commit its value.
ASSET_DELIVERY_SECRET=
APPWRITE_DATABASE_ID=ames
APPWRITE_COLLECTION_PROFILES=user_profiles
APPWRITE_COLLECTION_FAVORITES=favorites
APPWRITE_COLLECTION_SAVED=saved_assets
APPWRITE_COLLECTION_DESIGNS=generated_designs
APPWRITE_COLLECTION_ENTITLEMENTS=entitlements
APPWRITE_COLLECTION_SUBSCRIPTIONS=subscriptions
APPWRITE_COLLECTION_CATALOG=catalog_assets
APPWRITE_COLLECTION_EVENTS=analytics_events
APPWRITE_COLLECTION_LIMITS=auth_rate_limits
APPWRITE_BUCKET_JEWELRY=media
APPWRITE_BUCKET_STONES=media
APPWRITE_BUCKET_PREVIEWS=media
APPWRITE_BUCKET_GENERATED=media
# Local operator provisioning only; do not add this broader key to Vercel.
APPWRITE_PROVISION_KEY=
APPWRITE_ASSET_IMPORT_KEY=
# Server-only, independent high-entropy staff/portal signing secret, minimum 32 characters.
SESSION_SECRET=
# Explicit development-only provisioning; ignored in production.
APPWRITE_AUTO_PROVISION=false
# Optional existing integrations. No secret may use a NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY=
AI_BASE_URL=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# Public URL only; not an API credential.
# Dify Chatflow service API base, including /v1 (server only).
DIFY_API_URL=
DIFY_API_KEY=
# Independent random secret, at least 32 characters, for guest and conversation binding.
DIFY_SESSION_SECRET=
