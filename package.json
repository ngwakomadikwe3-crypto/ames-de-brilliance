{
  "name": "freebuff-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:ames-chat": "node scripts/sync-ames-chat.mjs",
    "sync:ames-boutique": "node scripts/sync-ames-boutique.mjs",
    "sync:ames-media": "node scripts/sync-ames-media.mjs",
    "sync:ames-content": "npm run sync:ames-chat && npm run sync:ames-boutique && npm run sync:ames-media",
    "test:ames-chat": "node --experimental-strip-types --test scripts/test-ames-chat.mjs",
    "test:ames-boutique": "node --experimental-strip-types --test scripts/test-ames-boutique.mjs",
    "test:ames-media": "node --experimental-strip-types --test scripts/test-ames-media.mjs",
    "test:jewelry-onboarding": "node --experimental-strip-types --test scripts/test-jewelry-onboarding.mjs scripts/test-jewelry-pack.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cad:worker": "node --env-file-if-exists=.env.cad-worker.local scripts/cad/worker.mjs",
    "test:cad": "node --test scripts/test-cad-processing.mjs",
    "test:cad:studio": "node --experimental-strip-types --test scripts/test-cad-studio.mjs",
    "test:jewellers": "node --experimental-strip-types --test scripts/test-jeweller-profiles.mjs",
    "cad:listing": "node --env-file=.env.cad-worker.local scripts/cad/listing-operator.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@google/model-viewer": "^4.3.1",
    "@react-pdf/renderer": "^4.8.1",
    "ames-engine": "file:vendor/ames-engine-0.1.24.tgz",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.1.1",
    "next": "16.4.3",
    "node-appwrite": "^28.0.0",
    "nodemailer": "10.1.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
