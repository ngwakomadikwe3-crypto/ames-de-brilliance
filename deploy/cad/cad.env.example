# Host-side broker only. Never expose these variables as NEXT_PUBLIC_*.
NODE_ENV=production
AMES_CAD_ROOT=/var/lib/ames-cad
AMES_CAD_SANDBOX=1
AMES_CAD_IMAGE=registry.example/ames-converter@sha256:REPLACE_WITH_REVIEWED_DIGEST
AMES_CAD_SERVICE_TOKEN=REPLACE_WITH_48_OR_MORE_RANDOM_CHARACTERS
APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT
APPWRITE_API_KEY=PRIVATE_SOURCE_READ_KEY
PORT=3020
