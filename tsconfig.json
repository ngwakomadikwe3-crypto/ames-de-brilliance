{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-local-workspace/types/**/*.ts",
    ".next-local-workspace/dev/types/**/*.ts",
    ".next-gem-refresh/types/**/*.ts",
    ".next-gem-refresh/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".ames-cad",
    "source-assets",
    "docs/qa",
    "share"
  ]
}
